# AURA - Environment Configuration
# PostgreSQL Database Settings
POSTGRES_USER=aura_user
POSTGRES_PASSWORD=aura_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=aura_reliability_db

# Standard PostgreSQL Connection URL (Used by Backend & Alembic)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://aura_user:aura_password@localhost:5432/aura_reliability_db

# Application Server Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO
